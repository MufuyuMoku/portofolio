---
import Base from '../layouts/Base.astro';
import Bagian from '../components/Bagian.astro';
import Kontak from '../components/Kontak.astro';
import { render } from 'astro:content';
import { halaman, type Bahasa } from '../lib/bahasa';
import { UI } from '../lib/teks';

interface Props { bahasa: Bahasa }
const { bahasa } = Astro.props;
const t = UI[bahasa];

const tentang = await halaman(bahasa, 'tentang');
const { Content } = await render(tentang);
---

<Base bahasa={bahasa} judul={t.tentang.toUpperCase()} deskripsi={t.deskripsiTentang}>
  <header class="kepala">
    <p class="label">{tentang.data.kicau}</p>
    <h1>{tentang.data.judul}</h1>
  </header>

  <Bagian label={t.catatan}>
    <article class="prose">
      <Content />
    </article>
  </Bagian>

  <Bagian label={t.kontak}>
    <Kontak bahasa={bahasa} />
  </Bagian>
</Base>

<style>
  .kepala h1 { margin: 1rem 0 0; }
</style>
