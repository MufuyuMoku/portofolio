---
import Base from '../layouts/Base.astro';
import Bagian from '../components/Bagian.astro';
import Spek from '../components/Spek.astro';
import Tangkapan from '../components/Tangkapan.astro';
import { render } from 'astro:content';
import { ul, type Bahasa, type KaryaBahasa } from '../lib/bahasa';
import { UI } from '../lib/teks';

interface Props {
  bahasa: Bahasa;
  entri: KaryaBahasa;
  berikut: KaryaBahasa;
}

const { bahasa, entri, berikut } = Astro.props;
const t = UI[bahasa];
const d = entri.data;
const { Content } = await render(entri.sumber);
const kerja = d.kelompok === 'pengalaman';
const tulisan = d.kelompok === 'tulisan';
// Karya yang masih rancangan belum punya data (tumpukan, platform, tautan),
// jadi panel datanya tidak ditampilkan.
const adaData = Boolean(d.peran || d.platform || d.perusahaan || d.tumpukan.length || d.tautan.length);
const jenis = d.jenis ?? (kerja ? t.jenisKerja : t.jenisKarya);
---

<Base bahasa={bahasa} judul={d.judul.toUpperCase()} deskripsi={d.ringkas}>
  <header class="kepala">
    <p class="label">{d.kode} — {jenis}</p>
    <h1>{d.judul}</h1>
    <p class="kepala__ringkas measure">{d.ringkas}</p>
    <p class:list={['status', `status--${d.keadaan}`, 'kepala__status']}>{d.status}</p>
    {d.catatan && <p class="kepala__catatan measure">{d.catatan}</p>}
    {!entri.terjemahan && <p class="kepala__catatan measure">{t.belumDiterjemahkan}</p>}
  </header>

  {adaData && <Bagian label={kerja ? t.dataPenempatan : t.dataKarya}>
    <div class:list={['panel', 'panel--bl', 'meta', { 'panel--inset': kerja }]}>
      <dl class="data">
        {d.perusahaan && <Fragment><dt>{t.perusahaan}</dt><dd>{d.perusahaan}</dd></Fragment>}
        {d.lokasi && <Fragment><dt>{t.lokasi}</dt><dd>{d.lokasi}</dd></Fragment>}
        {d.peran && <Fragment><dt>{kerja ? t.posisi : tulisan ? t.penulis : t.peran}</dt><dd>{d.peran}</dd></Fragment>}
        <dt>{t.periode}</dt><dd>{d.periode}</dd>
        {d.platform && <Fragment><dt>{tulisan ? t.bentuk : t.platform}</dt><dd>{d.platform}</dd></Fragment>}
        {d.tumpukan.length > 0 && (
          <Fragment>
            <dt>{t.tumpukan}</dt>
            <dd class="meta__tumpukan">{d.tumpukan.join('  ·  ')}</dd>
          </Fragment>
        )}
        {d.tautan.map((x) => (
          <Fragment>
            <dt>{x.label}</dt>
            <dd><a class="tautan" href={x.href} rel="noopener">{x.href.replace(/^https?:\/\//, '')}</a></dd>
          </Fragment>
        ))}
      </dl>
    </div>
  </Bagian>}

  {d.spek.length > 0 && (
    <Bagian label={t.angka}>
      <Spek spek={d.spek} />
    </Bagian>
  )}

  {d.tangkapan.length > 0 && (
    <Bagian label={t.tangkapanLayar}>
      <div class="tangkapan-daftar">
        {d.tangkapan.map((g, i) => (
          <Tangkapan bahasa={bahasa} src={g.src} alt={g.alt} keterangan={g.keterangan} indeks={i + 1} />
        ))}
      </div>
    </Bagian>
  )}

  <Bagian label={kerja ? t.catatanPenempatan : tulisan ? t.catatanKarya : t.catatanTeknis}>
    <article class="prose">
      <Content />
    </article>
  </Bagian>

  {berikut.id !== entri.id && (
    <nav class="lanjut" aria-label={t.karyaBerikutnya}>
      <a class="lanjut__tautan" href={ul(bahasa, `/karya/${berikut.id}`)}>
        <span class="label">{t.berikutnya} — {berikut.data.kode}</span>
        <span class="lanjut__judul">{berikut.data.judul}</span>
      </a>
    </nav>
  )}
</Base>

<style>
  .kepala h1 { margin: 1rem 0 0; }
  .kepala__ringkas {
    margin: 1.5rem 0 0;
    color: var(--fg-dim);
    font-size: 1rem;
    line-height: 1.8;
  }
  .kepala__status { margin-top: 1.5rem; }
  .kepala__catatan {
    margin: 0.9rem 0 0;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--fg-faint);
  }

  .meta { max-width: 44rem; }
  .meta__tumpukan { font-family: var(--font-mono); font-size: 0.8125rem; }
  .tautan { border-bottom: 1px solid var(--line); transition: border-color 0.18s linear; }
  .tautan:hover, .tautan:focus-visible { border-bottom-color: var(--accent); }

  .tangkapan-daftar { max-width: 46rem; }

  .lanjut { margin-top: 5rem; }
  .lanjut__tautan {
    display: block;
    border-top: 1px solid var(--line-soft);
    padding-top: 1.5rem;
    transition: border-color 0.18s linear;
  }
  .lanjut__tautan:hover,
  .lanjut__tautan:focus-visible { border-top-color: var(--accent); }
  .lanjut__judul {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 1.75rem;
    line-height: 1;
  }
</style>
