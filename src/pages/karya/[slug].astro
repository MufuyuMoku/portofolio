---
import Karya from '../../views/Karya.astro';
import { semuaKarya } from '../../lib/bahasa';

export async function getStaticPaths() {
  const urut = (await semuaKarya('id')).sort((a, b) => a.data.urutan - b.data.urutan);
  return urut.map((entri, i) => ({
    params: { slug: entri.id },
    props: { entri, berikut: urut[(i + 1) % urut.length] },
  }));
}
const { entri, berikut } = Astro.props;
---
<Karya bahasa="id" entri={entri} berikut={berikut} />
