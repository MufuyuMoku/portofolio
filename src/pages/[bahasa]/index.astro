---
import Beranda from '../../views/Beranda.astro';
import { BAHASA_TERJEMAHAN, type Bahasa } from '../../lib/bahasa';

export function getStaticPaths() {
  return BAHASA_TERJEMAHAN.map((bahasa) => ({ params: { bahasa } }));
}
const bahasa = Astro.params.bahasa as Bahasa;
---
<Beranda bahasa={bahasa} />
