---
import { aktif } from '../lib/url';
import { kelompokkan } from '../lib/kelompok';
import { semuaKarya, ul, jalurTanpaBahasa, BAHASA, LABEL_BAHASA, type Bahasa } from '../lib/bahasa';
import { UI } from '../lib/teks';

interface Props { bahasa: Bahasa }
const { bahasa } = Astro.props;
const t = UI[bahasa];
const kelompok = kelompokkan(await semuaKarya(bahasa), bahasa);
const here = Astro.url.pathname;
const jalur = jalurTanpaBahasa(here);

type Item = { kode: string; label: string; href: string } | { grup: string };
const nav: Item[] = [
  { kode: '00', label: t.beranda, href: ul(bahasa, '/') },
  ...kelompok.flatMap((k) => [
    { grup: k.pendek },
    ...k.isi.map((e) => ({ kode: e.data.kode, label: e.data.judul, href: ul(bahasa, `/karya/${e.id}`) })),
  ]),
  { grup: '' },
  { kode: '—', label: t.tentang, href: ul(bahasa, '/tentang') },
];
---

<aside class="rail">
  <div class="rail__atas">
    <a class="rail__mark" href={ul(bahasa, '/')}>Mufuyu</a>
    <p class="label rail__sub">{t.sub}</p>
  </div>

  <nav class="bahasa" aria-label={t.pilihBahasa}>
    {BAHASA.map((b) => (
      <a href={ul(b, jalur)} hreflang={b} lang={b} aria-current={b === bahasa ? 'true' : undefined}>{LABEL_BAHASA[b]}</a>
    ))}
  </nav>

  <nav class="nav" aria-label={t.navUtama}>
    <ul>
      {nav.map((item) => 'grup' in item ? (
        <li class="nav__grup" aria-hidden="true">{item.grup}</li>
      ) : (
        <li>
          <a href={item.href} class:list={['nav__item', { 'is-aktif': aktif(here, item.href) }]}
             aria-current={aktif(here, item.href) ? 'page' : undefined}>
            <span class="nav__kode">{item.kode}</span>
            <span class="nav__teks">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="rail__kaki">
    <hr class="rule rule--tight" />
    <p class="status">{t.bukaKerja}</p>
    <p class="label rail__tahun">MMXXVI</p>
  </div>
</aside>

<style>
  .rail__mark {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 1.125rem;
    color: var(--fg);
    display: block;
  }
  .rail__sub { margin-top: 0.4rem; }

  /* Pemilih bahasa */
  .bahasa { display: flex; gap: 0.2rem; margin-top: -0.75rem; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em; }
  .bahasa a { padding: 0.25rem 0.45rem; color: var(--fg-faint); border: 1px solid transparent; transition: color 0.18s linear, border-color 0.18s linear; }
  .bahasa a:hover, .bahasa a:focus-visible { color: var(--fg); }
  .bahasa a[aria-current] { color: var(--accent); border-color: var(--line); }

  .nav { margin-top: -0.5rem; }
  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav li + li { margin-top: 0.15rem; }

  /* Pemisah kelompok: label mono kecil, hanya di sidebar lebar. */
  .nav__grup {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
    padding: 0.85rem 0 0.2rem 0.6rem;
    border-top: 1px solid var(--line-soft);
    margin-top: 0.6rem !important;
    min-height: 0.6rem;
  }

  .nav__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.3rem 0 0.3rem 0.6rem;
    border-left: 1px solid transparent;
    transition: border-color 0.18s linear;
  }
  .nav__item:hover,
  .nav__item:focus-visible { border-left-color: var(--accent); }
  .nav__item.is-aktif { border-left-color: var(--accent); }

  .nav__kode {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }
  .nav__teks {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--fg-dim);
  }
  .nav__item.is-aktif .nav__teks { color: var(--fg); }

  .rail__kaki { margin-top: auto; }
  .rail__tahun { margin-top: 0.5rem; }

  @media (max-width: 60rem) {
    .rail__atas { display: flex; align-items: baseline; gap: 0.75rem; }
    .rail__sub { margin-top: 0; }
    .bahasa { margin-top: 0; }
    .nav { margin-top: 0; width: 100%; }
    .nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.25rem;
      border-top: 1px solid var(--line-soft);
      padding-top: 0.6rem;
    }
    .nav li + li { margin-top: 0; }
    .nav__grup { display: none; }
    .nav__item {
      grid-template-columns: auto auto;
      gap: 0.4rem;
      padding: 0.25rem 0 0.35rem;
      border-left: 0;
      border-bottom: 1px solid transparent;
    }
    .nav__item:hover,
    .nav__item:focus-visible,
    .nav__item.is-aktif { border-left-color: transparent; border-bottom-color: var(--accent); }
    .nav__teks { font-size: 0.875rem; }
    .rail__kaki { display: none; }
  }
</style>
