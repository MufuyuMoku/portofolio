---
import { u } from '../lib/url';

// Satu baris daftar karya di beranda. Sengaja baris penuh, bukan kartu.
interface Props {
  kode: string;
  judul: string;
  ringkas: string;
  status: string;
  keadaan: 'aktif' | 'selesai' | 'dihentikan' | 'arsip';
  periode: string;
  slug: string;
}
const { kode, judul, ringkas, status, keadaan, periode, slug } = Astro.props;
---

<a class="baris" href={u(`/karya/${slug}`)}>
  <span class="baris__kode">{kode}</span>
  <span class="baris__isi">
    <span class="baris__judul">{judul}</span>
    <span class="baris__ringkas">{ringkas}</span>
  </span>
  <span class="baris__meta">
    <span class:list={['status', `status--${keadaan}`]}>{status}</span>
    <span class="baris__periode">{periode}</span>
  </span>
</a>

<style>
  .baris {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 13rem;
    gap: 1.5rem;
    align-items: start;
    padding: 1.6rem 0 1.75rem;
    border-top: 1px solid var(--line-soft);
    transition: border-color 0.18s linear;
  }
  .baris:last-child { border-bottom: 1px solid var(--line-soft); }
  .baris:hover,
  .baris:focus-visible { border-top-color: var(--accent); }

  .baris__kode {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--fg-faint);
    padding-top: 0.45rem;
  }

  .baris__judul {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    line-height: 1.05;
    color: var(--fg);
  }
  .baris__ringkas {
    display: block;
    margin-top: 0.6rem;
    max-width: 46ch;
    color: var(--fg-dim);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .baris__meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.35rem;
  }
  .baris__periode {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    padding-left: 0.875rem;
  }

  @media (max-width: 60rem) {
    .baris {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 1.25rem 0 1.4rem;
    }
    .baris__meta { grid-column: 2; flex-direction: row; align-items: center; gap: 1rem; padding-top: 0.75rem; }
    .baris__periode { padding-left: 0; }
  }
</style>
